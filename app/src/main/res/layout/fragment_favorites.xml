<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_padding">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="-0.02"
            android:text="@string/tab_favorites"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/check"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_chip"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/check_now"
            android:textColor="@color/text"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_bell"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <TextView
        android:id="@+id/notify_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/page_padding"
        android:text="Уведомления о новых сериях включены"
        android:textColor="@color/text_mute"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layoutAnimation="@anim/layout_fall_down"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="10dp"
            android:scrollbars="none" />

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
