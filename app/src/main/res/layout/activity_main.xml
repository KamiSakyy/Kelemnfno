<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_history"
            style="@style/Widget.Kelemnfno.IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/history"
            android:src="@drawable/ic_history" />

        <ImageView
            android:id="@+id/btn_downloads"
            style="@style/Widget.Kelemnfno.IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/downloads"
            android:src="@drawable/ic_download" />

        <ImageView
            android:id="@+id/btn_settings"
            style="@style/Widget.Kelemnfno.IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />

        <ImageView
            android:id="@+id/btn_search"
            style="@style/Widget.Kelemnfno.IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/search_hint"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/nav"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:background="@color/nav_bg"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ripple_rounded"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="46dp"
                android:layout_height="28dp"
                android:contentDescription="@string/tab_home"
                android:padding="3dp"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_home"
                android:textColor="@color/text_mute"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_catalog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ripple_rounded"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_catalog_icon"
                android:layout_width="46dp"
                android:layout_height="28dp"
                android:contentDescription="@string/tab_catalog"
                android:padding="3dp"
                android:src="@drawable/ic_grid" />

            <TextView
                android:id="@+id/nav_catalog_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_catalog"
                android:textColor="@color/text_mute"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ripple_rounded"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_favorites_icon"
                android:layout_width="46dp"
                android:layout_height="28dp"
                android:contentDescription="@string/tab_favorites"
                android:padding="3dp"
                android:src="@drawable/ic_heart" />

            <TextView
                android:id="@+id/nav_favorites_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_favorites"
                android:textColor="@color/text_mute"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_calendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ripple_rounded"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_calendar_icon"
                android:layout_width="46dp"
                android:layout_height="28dp"
                android:contentDescription="@string/tab_calendar"
                android:padding="3dp"
                android:src="@drawable/ic_calendar" />

            <TextView
                android:id="@+id/nav_calendar_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_calendar"
                android:textColor="@color/text_mute"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
